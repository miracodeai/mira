{
  "_comment": "Per-provider quirks for the OpenAI-compatible client, matched by base_url (fields documented in provider_profiles.py). Any endpoint with no entry here gets the portable default: bare model name, no extra headers, no reasoning remap, and max_tokens. Override or extend via MIRA_PROVIDERS_JSON_PATH.",

  "openrouter": {
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "model_prefix": "keep",
    "extra_headers": {
      "HTTP-Referer": "https://github.com/miracodeai/mira",
      "X-Title": "Mira Code Reviewer"
    },
    "reasoning_effort_map": { "max": "xhigh" },
    "prompt_caching": "anthropic"
  },

  "deepseek": {
    "base_url": "https://api.deepseek.com/v1",
    "api_key_env": "DEEPSEEK_API_KEY",
    "model_prefix": "strip",
    "reasoning_effort_map": {
      "minimal": "low",
      "medium": "high",
      "xhigh": "high",
      "ultra": "max"
    },
    "reasoning_on_payload": { "thinking": { "type": "enabled" } },
    "reasoning_off_payload": { "thinking": { "type": "disabled" } },
    "reasoning_off_payload_responses": { "reasoning": { "effort": "none" } }
  },

  "deepseek-native": {
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "model_prefix": "strip",
    "reasoning_effort_map": {
      "minimal": "low",
      "medium": "high",
      "xhigh": "high",
      "ultra": "max"
    },
    "reasoning_on_payload": { "thinking": { "type": "enabled" } },
    "reasoning_off_payload": { "thinking": { "type": "disabled" } },
    "reasoning_off_payload_responses": { "reasoning": { "effort": "none" } }
  },

  "openai": {
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY",
    "model_prefix": "strip",
    "max_tokens_field": "max_completion_tokens"
  },

  "google": {
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "api_key_env": "GEMINI_API_KEY",
    "model_prefix": "strip",
    "reasoning_effort_map": { "xhigh": "high", "max": "high" }
  },

  "dashscope": {
    "base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "api_key_env": "DASHSCOPE_API_KEY",
    "model_prefix": "strip",
    "reasoning_effort_map": {
      "minimal": "low",
      "high": "xhigh",
      "max": "xhigh"
    }
  },

  "zai": {
    "base_url": "https://api.z.ai/api/paas/v4",
    "api_key_env": "ZAI_API_KEY",
    "model_prefix": "strip",
    "reasoning_effort_map": { "medium": "high", "xhigh": "max" }
  },

  "minimax": {
    "base_url": "https://api.minimax.io/v1",
    "api_key_env": "MINIMAX_API_KEY",
    "model_prefix": "strip",
    "max_tokens_field": "max_completion_tokens"
  },

  "xai": {
    "base_url": "https://api.x.ai/v1",
    "api_key_env": "XAI_API_KEY",
    "model_prefix": "strip"
  },

  "mistral": {
    "base_url": "https://api.mistral.ai/v1",
    "api_key_env": "MISTRAL_API_KEY",
    "model_prefix": "strip",
    "reasoning_effort_map": { "max": "xhigh" }
  },

  "groq": {
    "base_url": "https://api.groq.com/openai/v1",
    "api_key_env": "GROQ_API_KEY",
    "model_prefix": "strip",
    "max_tokens_field": "max_completion_tokens"
  },

  "cerebras": {
    "base_url": "https://api.cerebras.ai/v1",
    "api_key_env": "CEREBRAS_API_KEY",
    "model_prefix": "strip",
    "max_tokens_field": "max_completion_tokens",
    "reasoning_effort_map": { "xhigh": "high", "max": "high" }
  },

  "together": {
    "base_url": "https://api.together.xyz/v1",
    "api_key_env": "TOGETHER_API_KEY",
    "model_prefix": "strip",
    "reasoning_effort_map": { "xhigh": "high", "max": "high" }
  },

  "fireworks": {
    "base_url": "https://api.fireworks.ai/inference/v1",
    "api_key_env": "FIREWORKS_API_KEY",
    "model_prefix": "strip",
    "max_tokens_field": "max_completion_tokens"
  }
}
