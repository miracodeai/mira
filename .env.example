# Database
export DATABASE_URL=postgresql://mira:mira@localhost:5432/mira

# GitHub App
export MIRA_GITHUB_APP_ID=123456
export MIRA_GITHUB_PRIVATE_KEY_PATH=./private-key.pem
export MIRA_WEBHOOK_SECRET=your_webhook_secret_here
# Optional: override for GitHub Enterprise Server.
# Examples:
#   export MIRA_GITHUB_API_URL=https://github.acme-corp.com/api/v3
#   export MIRA_GITHUB_GRAPHQL_URL=https://github.acme-corp.com/api/graphql
# Optional: bot login override for self-checks. Defaults to "miracodeai".
# export MIRA_BOT_NAME=miracodeai

# Self-hosted Forgejo
# export MIRA_FORGEJO_API_URL=https://git.example.com/api/v1
# The web base is inferred by removing the trailing /api/v1 (subpaths preserved).
# For a nonstandard API URL, an explicit web base is required:
# export MIRA_FORGEJO_BASE_URL=https://git.example.com

# LLM (OpenRouter)
export OPENROUTER_API_KEY=sk-or-v1-your-key-here
export MIRA_MODEL=anthropic/claude-sonnet-4-6

# Dashboard
# Initial admin password. If unset, a random password is generated on first
# start and written to <MIRA_INDEX_DIR>/initial_admin_password (mode 0600).
# Never use a guessable value here.
# export ADMIN_PASSWORD=
export MIRA_INDEX_DIR=./data/indexes

# Dashboard single sign-on (OpenID Connect): any provider with discovery, e.g.
# Entra ID, Google, Okta, Keycloak, Forgejo. Register the redirect URL
# <MIRA_DASHBOARD_URL>/api/auth/oidc/callback with the provider.
# export MIRA_DASHBOARD_URL=https://mira.example.com
# export MIRA_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# export MIRA_OIDC_CLIENT_ID=
# Leave unset for a public client (PKCE only).
# export MIRA_OIDC_CLIENT_SECRET=
# Button text: "Sign in with <label>".
# export MIRA_OIDC_LABEL=Microsoft
# Needed behind a TLS-terminating proxy if MIRA_DASHBOARD_URL isn't the public URL.
# export MIRA_OIDC_REDIRECT_URL=https://mira.example.com/api/auth/oidc/callback
# Who may sign in (comma-separated; empty = anyone the provider authenticates).
# export MIRA_OIDC_ALLOWED_DOMAINS=example.com
# export MIRA_OIDC_ALLOWED_GROUPS=engineering
# Members are admins; re-checked on every sign-in.
# export MIRA_OIDC_ADMIN_GROUPS=mira-admins
# Claim holding the groups ("groups" by default; "roles" for Entra app roles).
# export MIRA_OIDC_GROUPS_CLAIM=groups
# Extra scopes, e.g. "openid email profile groups" for providers that need one.
# export MIRA_OIDC_SCOPES=openid email profile
# Set to false to leave single sign-on as the only interactive login.
# export MIRA_PASSWORD_LOGIN=true
